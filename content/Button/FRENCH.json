  "form": {
    "steps": [
      {
        "id": "customer_info",
        "title": "Informations client",
        "fields": [
          {
            "type": "text",
            "name": "full_name",
            "label": "Nom complet",
            "required": true
          },
          {
            "type": "email",
            "name": "email",
            "label": "Adresse e-mail",
            "required": true
          },
          {
            "type": "tel",
            "name": "phone",
            "label": "Numéro de téléphone (facultatif)",
            "required": false
          }
        ]
      },
      {
        "id": "purpose",
        "title": "Utilisation du bouton",
        "fields": [
          {
            "type": "select_box",
            "name": "purpose",
            "label": "Choisissez l’usage de votre bouton",
            "options": [
              "Mode concentration",
              "Lumière de lecture",
              "Soirée film",
              "Ambiance fête",
              "Autre usage"
            ],
            "required": true
          },
          {
            "type": "text",
            "name": "custom_purpose",
            "label": "Décrivez votre usage personnalisé",
            "placeholder": "ex. Bouton pour méditation du soir, Alarme d'étude...",
            "required": false,
            "conditional": {
              "field": "purpose",
              "value": "Autre usage"
            }
          }
        ]
      },
      {
        "id": "style",
        "title": "Style",
        "fields": [
          {
            "type": "select_box",
            "name": "shape",
            "label": "Forme",
            "options": [
              "Cercle",
              "Carré",
              "Hexagone",
              "Octogone",
              "Losange",
              "Étoile",
              "Triangle",
              "Cœur",
              "Ovale",
              "Pentagone",
              "Carré arrondi",
              "Pilule",
              "Nuage",
              "Fleur",
              "Éclair"
            ],
            "required": true
          },
          {
            "type": "select_box",
            "name": "color",
            "label": "Couleur",
            "options": [
              "Bleu",
              "#FF7A00",
              "Violet",
              "Vert",
              "Jaune",
              "Rose",
              "Rouge",
              "Turquoise",
              "Indigo",
              "Citron vert",
              "Cyan",
              "Orange",
              "Personnalisée"
            ],
            "required": true
          },
          {
            "type": "select_box",
            "name": "finish",
            "label": "Finition",
            "options": [
              "Mat",
              "Brillant",
              "Satiné",
              "Métallique",
              "Nacré",
              "Texturé",
              "Carbone",
              "Toucher doux"
            ],
            "required": true
          }
        ]
      },
      {
        "id": "label",
        "title": "Texte du bouton",
        "fields": [
          {
            "type": "text",
            "name": "label_text",
            "label": "Texte affiché sur le bouton",
            "maxLength": 12,
            "required": false
          },
          {
            "type": "range",
            "name": "text_size",
            "label": "Taille du texte",
            "min": 10,
            "max": 24,
            "default": 14
          }
        ]
      },
      {
        "id": "behavior",
        "title": "Comportement",
        "fields": [
          {
            "type": "textarea",
            "name": "button_behavior",
            "label": "Décrivez le comportement souhaité du bouton",
            "required": false
          }
        ]
      },
      {
        "id": "delivery",
        "title": "Livraison",
        "fields": [
          {
            "type": "text",
            "name": "street",
            "label": "Adresse",
            "required": true
          },
          {
            "type": "text",
            "name": "city",
            "label": "Ville",
            "required": true
          },
          {
            "type": "text",
            "name": "state",
            "label": "Région / Département",
            "required": true
          },
          {
            "type": "text",
            "name": "zip",
            "label": "Code postal",
            "required": true
          },
          {
            "type": "choice",
            "name": "country",
            "label": "Pays",
            "required": true,
            "options": [
              "France",
              "États-Unis",
              "Italie",
              "Arabie Saoudite",
              "Émirats Arabes Unis",
              "Algérie",
              "Allemagne",
              "Canada",
              "Autre"
            ]
          },
          {
            "type": "textarea",
            "name": "instructions",
            "label": "Instructions de livraison (facultatif)",
            "required": false
          }
        ]
      }
    ]
  }
}