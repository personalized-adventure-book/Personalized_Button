  "form": {
    "steps": [
      {
        "id": "customer_info",
        "title": "Informazioni Cliente",
        "icon": "user",
        "fields": [
          {
            "type": "text",
            "name": "full_name",
            "label": "Nome Completo",
            "placeholder": "Il tuo nome completo",
            "required": true
          },
          {
            "type": "email",
            "name": "email",
            "label": "Indirizzo Email",
            "placeholder": "tuo.nome@example.com",
            "required": true
          },
          {
            "type": "tel",
            "name": "phone",
            "label": "Numero di Telefono (opzionale)",
            "placeholder": "+39 123 456 7890",
            "required": false
          }
        ]
      },
      {
        "id": "gift",
        "title": "Questo è un Regalo?",
        "fields": [
          {
            "type": "choice",
            "name": "is_gift",
            "label": "Stai regalando questo pulsante?",
            "options": ["Sì", "No"],
            "required": true
          },
          {
            "type": "text",
            "name": "recipient_name",
            "label": "Nome del Destinatario",
            "required": false
          },
          {
            "type": "textarea",
            "name": "gift_message",
            "label": "Messaggio Regalo (opzionale)",
            "required": false
          },
          {
            "type": "choice",
            "name": "gift_wrap",
            "label": "Aggiungere una Confezione Regalo?",
            "options": ["Sì", "No"],
            "required": false
          }
        ]
      },
      {
        "id": "purpose",
        "title": "Finalità del Pulsante",
        "icon": "target",
        "fields": [
          {
            "type": "select_box",
            "name": "purpose",
            "label": "Scegli la finalità del tuo pulsante",
            "required": true,
            "options": [
              "Modalità concentrazione",
              "Luce per la lettura",
              "Serata cinema",
              "Festa",
              "Finalità personalizzata"
            ]
          },
          {
            "type": "text",
            "name": "custom_purpose",
            "label": "Descrivi la tua finalità personalizzata",
            "placeholder": "es. Pulsante per meditazione serale, Allarme per studio...",
            "required": false,
            "conditional": {
              "field": "purpose",
              "value": "Finalità personalizzata"
            }
          }
        ]
      },
      {
        "id": "style",
        "title": "Stile del Pulsante",
        "icon": "palette",
        "fields": [
          {
            "type": "select_box",
            "name": "shape",
            "label": "Forma",
            "required": true,
            "options": [
              "Cerchio",
              "Quadrato",
              "Esagono",
              "Ottagono",
              "Diamante",
              "Stella",
              "Triangolo",
              "Cuore",
              "Ovale",
              "Pentagono",
              "Quadrato Arrotondato",
              "Pillola",
              "Nuvola",
              "Fiore",
              "Fulmine"
            ]
          },
          {
            "type": "select",
            "name": "color",
            "label": "Colore LED",
            "required": true,
            "options": [
              "Blu",
              "Viola",
              "Verde",
              "Giallo",
              "Rosa",
              "Rosso",
              "Turchese",
              "Indaco",
              "Lime",
              "Ciano",
              "Arancione",
              "Personalizzato"
            ]
          },
          {
            "type": "select_box",
            "name": "finish",
            "label": "Finitura",
            "required": true,
            "options": [
              "Opaca",
              "Lucida",
              "Satinata",
              "Metallica",
              "Perlata",
              "Testurizzata",
              "Fibra di Carbonio",
              "Soft Touch"
            ]
          }
        ]
      },
      {
        "id": "label",
        "title": "Etichetta del Pulsante",
        "icon": "type",
        "fields": [
          {
            "type": "text",
            "name": "label_text",
            "label": "Testo sul Pulsante",
            "placeholder": "es. Ti Amo, Modalità Focus",
            "maxLength": 25,
            "required": false
          },
          {
            "type": "range",
            "name": "text_size",
            "label": "Dimensione del Testo",
            "min": 10,
            "max": 24,
            "default": 14
          }
        ]
      },
      {
        "id": "behavior",
        "title": "Comportamento del Pulsante",
        "icon": "zap",
        "fields": [
          {
            "type": "textarea",
            "name": "button_behavior",
            "label": "Descrivi il comportamento del pulsante",
            "placeholder": "Descrivi cosa succede quando si preme il pulsante...",
            "required": false
          }
        ]
      },
      {
        "id": "delivery",
        "title": "Informazioni di Spedizione",
        "icon": "map",
        "fields": [
          {
            "type": "text",
            "name": "street",
            "label": "Indirizzo",
            "placeholder": "Indirizzo, casella postale",
            "required": true
          },
          {
            "type": "text",
            "name": "city",
            "label": "Città",
            "required": true
          },
          {
            "type": "text",
            "name": "state",
            "label": "Provincia/Stato",
            "required": true
          },
          {
            "type": "text",
            "name": "zip",
            "label": "CAP",
            "required": true
          },
          {
            "type": "choice",
            "name": "country",
            "label": "Paese",
            "required": true,
            "options": [
              "Francia",
              "Stati Uniti",
              "Italia",
              "Arabia Saudita",
              "Emirati Arabi Uniti",
              "Algeria",
              "Germania",
              "Canada",
              "Altro"
            ]
          },
          {
            "type": "textarea",
            "name": "instructions",
            "label": "Istruzioni di Consegna (opzionale)",
            "placeholder": "es. Lascia alla porta o al vicino",
            "required": false
          }
        ]
      }
    ]
  }
}