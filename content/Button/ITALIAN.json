  "form": {
    "steps": [
      {
        "id": "customer_info",
        "title": "Informazioni cliente",
        "fields": [
          {
            "type": "text",
            "name": "full_name",
            "label": "Nome completo",
            "required": true
          },
          {
            "type": "email",
            "name": "email",
            "label": "Indirizzo e-mail",
            "required": true
          },
          {
            "type": "tel",
            "name": "phone",
            "label": "Numero di telefono (facoltativo)",
            "required": false
          }
        ]
      },
      {
        "id": "purpose",
        "title": "Scopo del pulsante",
        "fields": [
          {
            "type": "select",
            "name": "purpose",
            "label": "Scegli l’uso del tuo pulsante",
            "options": [
              "Modalità concentrazione",
              "Luce da lettura",
              "Serata film",
              "Atmosfera festa",
              "Altro uso"
            ],
            "required": true
          }
        ]
      },
      {
        "id": "style",
        "title": "Stile",
        "fields": [
          {
            "type": "select",
            "name": "shape",
            "label": "Forma",
            "options": [
              "Cerchio",
              "Quadrato",
              "Esagono",
              "Ottagono",
              "Rombo",
              "Stella",
              "Triangolo",
              "Cuore",
              "Ovale",
              "Pentagono",
              "Quadrato arrotondato",
              "Pillola",
              "Nuvola",
              "Fiore",
              "Saetta"
            ],
            "required": true
          },
          {
            "type": "select",
            "name": "color",
            "label": "Colore",
            "options": [
              "Blu",
              "#FF7A00",
              "Viola",
              "Verde",
              "Giallo",
              "Rosa",
              "Rosso",
              "Turchese",
              "Indaco",
              "Lime",
              "Ciano",
              "Arancione",
              "Personalizzato"
            ],
            "required": true
          },
          {
            "type": "select",
            "name": "finish",
            "label": "Finitura",
            "options": [
              "Opaco",
              "Lucido",
              "Satinato",
              "Metallico",
              "Perlato",
              "Testurizzato",
              "Fibra di carbonio",
              "Soft Touch"
            ],
            "required": true
          }
        ]
      },
      {
        "id": "label",
        "title": "Testo del pulsante",
        "fields": [
          {
            "type": "text",
            "name": "label_text",
            "label": "Testo sul pulsante",
            "maxLength": 12,
            "required": false
          },
          {
            "type": "range",
            "name": "text_size",
            "label": "Dimensione del testo",
            "min": 10,
            "max": 24,
            "default": 14
          }
        ]
      },
      {
        "id": "behavior",
        "title": "Comportamento",
        "fields": [
          {
            "type": "textarea",
            "name": "button_behavior",
            "label": "Descrivi il comportamento desiderato del pulsante",
            "required": false
          }
        ]
      },
      {
        "id": "delivery",
        "title": "Consegna",
        "fields": [
          {
            "type": "text",
            "name": "street",
            "label": "Indirizzo",
            "required": true
          },
          {
            "type": "text",
            "name": "city",
            "label": "Città",
            "required": true
          },
          {
            "type": "text",
            "name": "state",
            "label": "Regione / Provincia",
            "required": true
          },
          {
            "type": "text",
            "name": "zip",
            "label": "CAP / Codice postale",
            "required": true
          },
          {
            "type": "choice",
            "name": "country",
            "label": "Paese",
            "required": true,
            "options": [
              "Francia",
              "Stati Uniti",
              "Italia",
              "Arabia Saudita",
              "Emirati Arabi Uniti",
              "Algeria",
              "Germania",
              "Canada",
              "Altro"
            ]
          },
          {
            "type": "textarea",
            "name": "instructions",
            "label": "Istruzioni di consegna (facoltativo)",
            "required": false
          }
        ]
      }
    ]
  }
