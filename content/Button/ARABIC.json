  "form": {
    "steps": [
      {
        "id": "customer_info",
        "title": "معلومات العميل",
        "icon": "user",
        "fields": [
          {
            "type": "text",
            "name": "full_name",
            "label": "الاسم الكامل",
            "placeholder": "اسمك الكامل",
            "required": true
          },
          {
            "type": "email",
            "name": "email",
            "label": "عنوان البريد الإلكتروني",
            "placeholder": "your.name@example.com",
            "required": true
          },
          {
            "type": "tel",
            "name": "phone",
            "label": "رقم الهاتف (اختياري)",
            "placeholder": "+1 234 567 8900",
            "required": false
          }
        ]
      },
      {
        "id": "gift",
        "title": "هل هذا هدية؟",
        "fields": [
          {
            "type": "choice",
            "name": "is_gift",
            "label": "هل تقدم هذا الزر كهدية؟",
            "options": [
              "نعم",
              "لا"
            ],
            "required": true
          },
          {
            "type": "text",
            "name": "recipient_name",
            "label": "اسم المستلم",
            "required": false
          },
          {
            "type": "textarea",
            "name": "gift_message",
            "label": "رسالة الهدية (اختياري)",
            "required": false
          },
          {
            "type": "choice",
            "name": "gift_wrap",
            "label": "إضافة تغليف هدية؟",
            "options": [
              "نعم",
              "لا"
            ],
            "required": false
          }
        ]
      },
      {
        "id": "purpose",
        "title": "غرض الزر",
        "icon": "target",
        "fields": [
          {
            "type": "select_box",
            "name": "purpose",
            "label": "اختر غرض الزر",
            "required": true,
            "options": [
              "وضع التركيز",
              "إضاءة القراءة",
              "ليلة أفلام",
              "حفلة",
              "غرض مخصص"
            ]
          },
          {
            "type": "text",
            "name": "custom_purpose",
            "label": "صف غرضك المخصص",
            "placeholder": "مثال: زر التأمل المسائي، منبه الدراسة...",
            "required": false,
            "conditional": {
              "field": "purpose",
              "value": "غرض مخصص"
            }
          }
        ]
      },
      {
        "id": "style",
        "title": "نمط الزر",
        "icon": "palette",
        "fields": [
          {
            "type": "select_box",
            "name": "shape",
            "label": "الشكل",
            "required": true,
            "options": [
              "دائرة",
              "مربع",
              "سداسي",
              "مثمن",
              "ماسي",
              "نجمة",
              "مثلث",
              "قلب",
              "بيضاوي",
              "خماسي",
              "مربع دائري الزوايا",
              "كبسولة",
              "سحابة",
              "زهرة",
              "برق"
            ]
          },
          {
            "type": "select",
            "name": "color",
            "label": "لون LED",
            "required": true,
            "options": [
              "أزرق",
              "بنفسجي",
              "أخضر",
              "أصفر",
              "وردي",
              "أحمر",
              "فيروزي",
              "نيلي",
              "ليموني",
              "سماوي",
              "برتقالي",
              "مخصص"
            ]
          },
          {
            "type": "select_box",
            "name": "finish",
            "label": "اللمسة النهائية",
            "required": true,
            "options": [
              "مطفأ",
              "لامع",
              "حريري",
              "معدني",
              "لؤلؤي",
              "ذو ملمس",
              "ألياف كربونية",
              "ملمس ناعم"
            ]
          }
        ]
      },
      {
        "id": "label",
        "title": "تسمية الزر",
        "icon": "type",
        "fields": [
          {
            "type": "text",
            "name": "label_text",
            "label": "نص الزر",
            "placeholder": "مثلاً: أحبك، وضع التركيز",
            "maxLength": 25,
            "required": false
          },
          {
            "type": "range",
            "name": "text_size",
            "label": "حجم النص",
            "min": 10,
            "max": 24,
            "default": 14
          }
        ]
      },
      {
        "id": "behavior",
        "title": "سلوك الزر",
        "icon": "zap",
        "fields": [
          {
            "type": "textarea",
            "name": "button_behavior",
            "label": "صف سلوك الزر عند الضغط",
            "placeholder": "صف ما يحدث عند الضغط على الزر...",
            "required": false
          }
        ]
      },
      {
        "id": "delivery",
        "title": "معلومات التوصيل",
        "icon": "map",
        "fields": [
          {
            "type": "text",
            "name": "street",
            "label": "عنوان الشارع",
            "placeholder": "عنوان الشارع أو صندوق البريد",
            "required": true
          },
          {
            "type": "text",
            "name": "city",
            "label": "المدينة",
            "required": true
          },
          {
            "type": "text",
            "name": "state",
            "label": "الولاية / المقاطعة",
            "required": true
          },
          {
            "type": "text",
            "name": "zip",
            "label": "الرمز البريدي",
            "required": true
          },
          {
            "type": "choice",
            "name": "country",
            "label": "البلد",
            "required": true,
            "options": [
              "فرنسا",
              "الولايات المتحدة",
              "إيطاليا",
              "السعودية",
              "الإمارات",
              "الجزائر",
              "ألمانيا",
              "كندا",
              "أخرى"
            ]
          },
          {
            "type": "textarea",
            "name": "instructions",
            "label": "تعليمات التوصيل (اختياري)",
            "placeholder": "مثلاً: اتركه عند الباب الأمامي أو مع الجار",
            "required": false
          }
        ]
      }
    ]
  }
