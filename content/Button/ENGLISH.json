  "form": {
    "steps": [
      {
        "id": "customer_info",
        "title": "Customer Info",
        "fields": [
          {
            "type": "text",
            "name": "full_name",
            "label": "Full Name",
            "required": true
          },
          {
            "type": "email",
            "name": "email",
            "label": "Email Address",
            "required": true
          },
          {
            "type": "tel",
            "name": "phone",
            "label": "Phone Number (optional)",
            "required": false
          }
        ]
      },
      {
        "id": "purpose",
        "title": "Purpose",
        "fields": [
          {
            "type": "select",
            "name": "purpose",
            "label": "Choose Your Button's Purpose",
            "options": [
              "Focus Mode",
              "Reading Light",
              "Movie Night",
              "Party Scene",
              "Custom Purpose"
            ],
            "required": true
          }
        ]
      },
      {
        "id": "style",
        "title": "Style",
        "fields": [
          {
            "type": "select",
            "name": "shape",
            "label": "Shape",
            "options": [
              "Circle",
              "Square",
              "Hexagon",
              "Octagon",
              "Diamond",
              "Star",
              "Triangle",
              "Heart",
              "Oval",
              "Pentagon",
              "Rounded Square",
              "Pill",
              "Cloud",
              "Flower",
              "Lightning"
            ],
            "required": true
          },
          {
            "type": "select",
            "name": "color",
            "label": "Color",
            "options": [
              "Blue",
              "#FF7A00",
              "Purple",
              "Green",
              "Yellow",
              "Pink",
              "Red",
              "Teal",
              "Indigo",
              "Lime",
              "Cyan",
              "Orange",
              "Custom"
            ],
            "required": true
          },
          {
            "type": "select",
            "name": "finish",
            "label": "Finish",
            "options": [
              "Matte",
              "Glossy",
              "Satin",
              "Metallic",
              "Pearl",
              "Textured",
              "Carbon Fiber",
              "Soft Touch"
            ],
            "required": true
          }
        ]
      },
      {
        "id": "label",
        "title": "Label",
        "fields": [
          {
            "type": "text",
            "name": "label_text",
            "label": "Button Text",
            "maxLength": 12,
            "required": false
          },
          {
            "type": "range",
            "name": "text_size",
            "label": "Text Size",
            "min": 10,
            "max": 24,
            "default": 14
          }
        ]
      },
      {
        "id": "behavior",
        "title": "Behavior",
        "fields": [
          {
            "type": "textarea",
            "name": "button_behavior",
            "label": "Describe your button's behavior",
            "required": false
          }
        ]
      },
      {
        "id": "delivery",
        "title": "Delivery",
        "fields": [
          {
            "type": "text",
            "name": "street",
            "label": "Street Address",
            "required": true
          },
          {
            "type": "text",
            "name": "city",
            "label": "City",
            "required": true
          },
          {
            "type": "text",
            "name": "state",
            "label": "State/Province",
            "required": true
          },
          {
            "type": "text",
            "name": "zip",
            "label": "IP/Postal Code",
            "required": true
          },
          {
            "type": "choice",
            "name": "country",
            "label": "Country",
            "required": true,
            "options": [
              "France",
              "United States",
              "Italy",
              "Saudi Arabia",
              "United Arab Emirates",
              "Algeria",
              "Germany",
              "Canada",
              "Other"
            ]
          },
          {
            "type": "textarea",
            "name": "instructions",
            "label": "Delivery Instructions (optional)",
            "required": false
          }
        ]
      }
    ]
  }
