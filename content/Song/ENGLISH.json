  "form": {
    "steps": [
      {
        "id": "song_purpose",
        "title": "Occasion & Recipient",
        "fields": [
          { "type": "select_box", "name": "occasion", "label": "Occasion", "required": true, "options": ["Birthday", "Anniversary", "Proposal", "Motivation", "Friendship", "Just Because", "Custom..."] },
          { "type": "text", "name": "custom_occasion", "label": "Custom Occasion", "required": false, "conditional": { "field": "occasion", "value": "Custom..." } },
          { "type": "text", "name": "recipient_name", "label": "Recipient Name", "placeholder": "Name of who the song is for (you or someone else)", "required": false }
          
        ]
      },
      {
        "id": "style",
        "title": "Style & Mood",
        "fields": [
          { "type": "select_box", "name": "primary_style", "label": "Primary Style", "required": true, "options": ["Pop", "Acoustic", "Piano", "Cinematic", "Lofi", "Ambient", "Electronic", "Folk", "Epic", "Orchestral", "Jazz", "Chill", "Trap", "Rock", "Custom Style"] },
          { "type": "text", "name": "custom_style", "label": "Describe Custom Style", "required": true, "placeholder": "e.g., Retro synthwave + orchestral", "conditional": { "field": "primary_style", "value": "Custom Style" } },
          { "type": "select_box", "name": "mood", "label": "Main Mood", "required": true, "options": ["Happy", "Romantic", "Melancholic", "Empowering", "Inspiring", "Calm", "Energetic", "Uplifting", "Dreamy", "Custom Mood"] },
          { "type": "text", "name": "custom_mood", "label": "Custom Mood", "required": false, "conditional": { "field": "mood", "value": "Custom Mood" } },
          { "type": "select_box", "name": "lyric_focus", "label": "Lyric Focus", "required": true, "options": ["Names", "Storytelling", "Message Emphasis", "Minimal Lyrics", "Instrumental", "Custom Focus"] },
          { "type": "text", "name": "custom_focus", "label": "Custom Lyric Focus", "required": false, "conditional": { "field": "lyric_focus", "value": "Custom Focus" } }
        ]
      },
      {
        "id": "extras",
        "title": "Extras",
        "fields": [
          { "type": "select_box", "name": "length", "label": "Song Length", "required": true, "options": ["~60s", "~90s", "Up to 120s"] }
        ]
      },
      {
        "id": "story_details",
        "title": "Story / Key Details",
        "fields": [
          { "type": "suggestion_textarea", "name": "story", "label": "Story / Key Details", "suggestions": [
            "Best friend turning 30 – loves hiking & coffee",
            "Romantic 5th anniversary – include 'forever my home'",
            "Birthday hype for my brother (just graduated)",
            "Motivation: overcoming challenges & staying resilient",
            "Lullaby for baby niece Lina (gentle, soothing)",
            "Proposal build up ending with 'Will you marry me?'",
            "Include inside joke about 'midnight noodle runs'",
            "Add hopeful tone about new beginnings in 2025"
          ], "placeholder": "Write a few lines about the context, feelings, names, phrases...", "helper": "Click suggestions to append. Add names, emotions, inside jokes, key phrases.", "maxLength": 600, "required": false }
        ]
      },
      {
        "id": "voice",
        "title": "Voice & Lyrics",
        "description": "Optional voice cloning (1–2 min spoken sample). We only use the sample to generate THIS song and do not store, sell, or misuse your voice.",
        "fields": [
          { "type": "binary_cards", "name": "voice_option", "label": "Voice Option", "required": true, "helper": "Custom voice adds cloning of your tone from a short spoken sample.", "options": [
            { "label": "Standard Voice", "value": "Standard Voice", "description": "Professionally produced vocal in a fitting style." },
            { "label": "Custom Voice (Your Voice)", "value": "Custom Voice (Your Voice)", "description": "We recreate your vocal timbre. Sample deleted after rendering.", "badge": "+50€", "icon": "mic" }
          ] },
          { "type": "file", "name": "voice_sample", "label": "Upload Voice Sample (1–2 min speaking)", "required": false, "accept": "audio/*", "multiple": false, "conditional": { "field": "voice_option", "value": "Custom Voice (Your Voice)" } },
          { "type": "binary_cards", "name": "lyric_video", "label": "Lyric Video", "required": true, "helper": "Choose whether you want a lyric video.", "options": [
            { "label": "No Video", "value": "No Video", "description": "Just audio + lyrics PDF." },
            { "label": "Lyric Video", "value": "Lyric Video", "description": "We create a simple lyric video.", "icon": "video" }
          ] },
          { "type": "file", "name": "lyric_video_cover", "label": "Lyric Video Cover Image (optional)", "required": false, "accept": "image/*", "multiple": false, "helper": "Upload an image if you selected lyric video.", "conditional": { "field": "lyric_video", "value": "Lyric Video" } },
          { "type": "binary_cards", "name": "lyrics_source", "label": "Lyrics Source", "required": true, "helper": "Provide yours if you already wrote lines; otherwise let us craft them.", "options": [
            { "label": "We generate the lyrics", "value": "We generate the lyrics", "description": "We write original lyrics based on your inputs." },
            { "label": "I will provide the lyrics", "value": "I will provide the lyrics", "description": "You paste draft or full lyrics (we may lightly adapt).", "badge": "-5€", "icon": "star" }
          ] },
            { "type": "textarea", "name": "provided_lyrics", "label": "Enter Lyrics (draft / key lines)", "required": false, "placeholder": "Paste your lyrics or outline...", "conditional": { "field": "lyrics_source", "value": "I will provide the lyrics" } },
          { "type": "textarea", "name": "voice_note", "label": "Additional Notes (voice / pronunciation)", "required": false, "placeholder": "Pronunciations, names, accents, pacing..." }
        ]
      },
      {
        "id": "customer_info",
        "title": "Your Info",
        "fields": [
          { "type": "text", "name": "full_name", "label": "Full Name", "required": true },
          { "type": "email", "name": "email", "label": "Email Address", "required": true },
          { "type": "tel", "name": "phone", "label": "Phone Number (optional)", "required": false }
        ]
      },
      {
        "id": "delivery",
        "title": "Delivery",
        "fields": [
          { "type": "text", "name": "street", "label": "Street Address", "required": true },
          { "type": "text", "name": "city", "label": "City", "required": true },
          { "type": "text", "name": "state", "label": "State/Province", "required": false },
          { "type": "text", "name": "zip", "label": "Postal Code", "required": true },
          { "type": "choice", "name": "country", "label": "Country", "required": true, "options": ["France", "United States", "Italy", "Saudi Arabia", "United Arab Emirates", "Algeria", "Germany", "Canada", "Other"] },
          { "type": "textarea", "name": "instructions", "label": "Delivery Instructions (optional)", "required": false }
        ]
      }
    ]
  },
