        "fields": [
          { "type": "text", "name": "street", "label": "Adresse", "required": true },
            { "type": "text", "name": "city", "label": "Ville", "required": true },
            { "type": "text", "name": "state", "label": "Région / Province", "required": false },
            { "type": "text", "name": "zip", "label": "Code postal", "required": true },
