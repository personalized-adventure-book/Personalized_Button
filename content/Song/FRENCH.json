  "form": {
    "steps": [
      {
        "id": "song_purpose",
        "title": "Occasion & Destinataire",
        "fields": [
          { "type": "select_box", "name": "occasion", "label": "Occasion", "required": true, "options": ["Anniversaire", "Anniversaire de couple", "Demande en mariage", "Motivation", "Amitié", "Juste comme ça", "Personnalisé..."] },
