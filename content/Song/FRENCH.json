        ]
      },
      {
        "id": "style",
        "title": "Style & Ambiance",
        "fields": [
          { "type": "select_box", "name": "primary_style", "label": "Style principal", "required": true, "options": ["Pop", "Acoustique", "Piano", "Cinématique", "Lofi", "Ambiant", "Électronique", "Folk", "Épique", "Orchestral", "Jazz", "Détente", "Trap", "Rock", "Style personnalisé"] },
          { "type": "text", "name": "custom_style", "label": "Décrivez le style personnalisé", "required": true, "placeholder": "ex: Synthwave rétro + orchestral", "conditional": { "field": "primary_style", "value": "Style personnalisé" } },
          { "type": "select_box", "name": "mood", "label": "Humeur principale", "required": true, "options": ["Heureux", "Romantique", "Mélancolique", "Motivant", "Inspirant", "Calme", "Énergique", "Élévateur", "Rêveur", "Humeur personnalisée"] },
