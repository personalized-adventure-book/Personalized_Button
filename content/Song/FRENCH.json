            "Anniv frère diplômé – énergie motivante",
            "Motivation personnelle – résilience & dépassement",
            "Berceuse douce pour ma nièce Lina",
            "Demande en mariage avec montée finale",
            "Ajouter une blague interne 'tacos du mardi'",
            "Tonalité d'espoir pour nouveaux débuts 2025"
          ], "placeholder": "Quelques lignes sur le contexte, émotions, noms, phrases...", "helper": "Cliquez pour ajouter. Ajoutez prénoms, souvenirs, blagues internes, mots clés.", "maxLength": 600, "required": false }
        ]
      },
      {
        "id": "voice",
        "title": "Voix & Paroles",
        "description": "Option de reproduction de votre voix (échantillon parlé 1–2 minutes). Nous utilisons uniquement cet enregistrement pour cette chanson et ne le stockons pas, ne le réutilisons pas et ne le vendons pas.",
        "fields": [
          { "type": "binary_cards", "name": "voice_option", "label": "Voix", "required": true, "helper": "Option personnalisée = clonage de votre timbre à partir d'un court extrait parlé.", "options": [
            { "label": "Voix standard", "value": "Voix standard", "description": "Voix produite pro adaptée au style choisi." },
            { "label": "Voix personnalisée (votre voix)", "value": "Voix personnalisée (votre voix)", "description": "Recréation de votre timbre. Échantillon supprimé ensuite.", "badge": "+50€", "icon": "mic" }
          ] },
          { "type": "file", "name": "voice_sample", "label": "Téléversez un échantillon (1–2 min parlé)", "required": false, "accept": "audio/*", "multiple": false, "conditional": { "field": "voice_option", "value": "Voix personnalisée (votre voix)" } },
          { "type": "binary_cards", "name": "lyric_video", "label": "Vidéo paroles", "required": true, "helper": "Choisissez si vous voulez une vidéo paroles.", "options": [
            { "label": "Pas de vidéo", "value": "Pas de vidéo", "description": "Audio + PDF paroles uniquement." },
            { "label": "Vidéo paroles", "value": "Vidéo paroles", "description": "Création d'une vidéo paroles simple.", "icon": "video" }
          ] },
          { "type": "file", "name": "lyric_video_cover", "label": "Image de couverture vidéo paroles (optionnel)", "required": false, "accept": "image/*", "multiple": false, "helper": "Ajoutez une image si vous avez choisi la vidéo paroles.", "conditional": { "field": "lyric_video", "value": "Vidéo paroles" } },
          { "type": "binary_cards", "name": "lyrics_source", "label": "Source des paroles", "required": true, "helper": "Fournissez les vôtres si elles sont déjà écrites sinon laissez-nous créer.", "options": [
            { "label": "Nous générons les paroles", "value": "Nous générons les paroles", "description": "On écrit des paroles originales à partir de vos infos." },
            { "label": "Je fournis les paroles", "value": "Je fournis les paroles", "description": "Vous collez un brouillon ou complet (on peut ajuster léger).", "badge": "-5€", "icon": "star" }
          ] },
          { "type": "textarea", "name": "provided_lyrics", "label": "Saisissez les paroles (brouillon / idées clés)", "required": false, "placeholder": "Collez vos paroles ou points clés...", "conditional": { "field": "lyrics_source", "value": "Je fournis les paroles" } },
          { "type": "textarea", "name": "voice_note", "label": "Notes supplémentaires (voix / prononciation)", "required": false, "placeholder": "Prononciations, noms, accents..." }
        ]
      },
      {
        "id": "customer_info",
        "title": "Vos informations",
        "fields": [
          { "type": "text", "name": "full_name", "label": "Nom complet", "required": true },
          { "type": "email", "name": "email", "label": "Adresse email", "required": true },
          { "type": "tel", "name": "phone", "label": "Numéro de téléphone (optionnel)", "required": false }
