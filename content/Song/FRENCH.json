          { "type": "text", "name": "custom_focus", "label": "Focus personnalisé", "required": false, "conditional": { "field": "lyric_focus", "value": "Focalisation personnalisée" } }
        ]
      },
      {
        "id": "extras",
        "title": "Extras",
        "fields": [
          { "type": "select_box", "name": "length", "label": "Durée", "required": true, "options": ["~60s", "~90s", "Jusqu'à 120s"] }
