  "form": {
    "steps": [
      {
        "id": "client_info",
        "title": "معلومات العمل",
        "icon": "briefcase",
        "fields": [
          {
            "type": "text",
            "name": "client_name",
            "label": "اسمك",
            "placeholder": "مثال: سارة جونسون",
            "required": true
          },
          {
            "type": "email",
            "name": "client_email",
            "label": "عنوان البريد الإلكتروني",
            "placeholder": "your.name@example.com",
            "required": true
          },
          {
            "type": "text",
            "name": "business_name",
            "label": "اسم النشاط أو العلامة التجارية",
            "placeholder": "مثال: استوديو سول بلوم",
            "required": true
          },
          {
            "type": "choice",
            "name": "language",
            "label": "اللغة المفضلة",
            "placeholder": "اختر لغتك المفضلة",
            "required": true,
            "options": [
              "الإنجليزية",
              "الفرنسية",
              "العربية",
              "الإيطالية"
            ]
          }
        ]
      },
      {
        "id": "brand_details",
        "title": "هوية العلامة التجارية",
        "icon": "palette",
        "fields": [
          {
            "type": "text",
            "name": "brand_keywords",
            "label": "كلمات تصف علامتك التجارية",
            "placeholder": "مثال: هادئة، بسيطة، ترابية، فاخرة",
            "required": true
          },
          {
            "type": "textarea",
            "name": "brand_story",
            "label": "أخبرنا عن علامتك التجارية",
            "placeholder": "ما هي مهمتك، قصتك، أو فلسفتك؟",
            "required": true
          },
          {
            "type": "text",
            "name": "preferred_colors",
            "label": "الألوان المفضلة",
            "placeholder": "مثال: أخضر حكيم، ذهبي ناعم، أبيض"
          },
          {
            "type": "text",
            "name": "avoid_elements",
            "label": "عناصر لتجنبها",
            "placeholder": "الألوان، الأيقونات، الأنماط التي لا تريدها"
          }
        ]
      },
      {
        "id": "product_selection",
        "title": "اختر عناصر الهوية البصرية",
        "icon": "tag",
        "fields": [
          {
            "type": "checkbox",
            "name": "branding_products",
            "label": "ما الذي تود منا تخصيصه لك؟",
            "options": [
              "الشعار",
              "بطاقات العمل",
              "تغليف المنتجات",
              "الأكواب أو الزجاجات",
              "الشموع أو الديكور",
              "نماذج العملاء",
              "بطاقات الهدايا",
              "الملصقات واللافتات",
              "أطقم الترحيب",
              "تنسيق غرفة الانتظار"
            ],
            "required": true
          },
          {
            "type": "text",
            "name": "product_quantity",
            "label": "الكمية التقريبية (إن كانت منتجات مادية)",
            "placeholder": "مثال: 100 ملصق، 20 شمعة، إلخ."
          },
          {
            "type": "textarea",
            "name": "custom_requests",
            "label": "هل لديك أفكار أو طلبات مخصصة؟",
            "placeholder": "أخبرنا بأي أفكار أو مصادر إلهام إضافية لديك"
          }
        ]
      },
      {
        "id": "inspiration_upload",
        "title": "رفع مصادر الإلهام (اختياري)",
        "icon": "upload",
        "fields": [
          {
            "type": "file",
            "name": "reference_images",
            "label": "قم برفع صور أو شعارات للإلهام"
          },
          {
            "type": "text",
            "name": "reference_links",
            "label": "رابط إلى Pinterest أو Instagram أو موقعك (اختياري)",
            "placeholder": "مثال: https://pinterest.com/yourboard"
          }
        ]
      },
      {
        "id": "shipping_info",
        "title": "معلومات الشحن",
        "icon": "map",
        "fields": [
          {
            "type": "text",
            "name": "address_line1",
            "label": "السطر الأول من العنوان",
            "placeholder": "العنوان، صندوق البريد",
            "required": true
          },
          {
            "type": "text",
            "name": "address_line2",
            "label": "السطر الثاني من العنوان",
            "placeholder": "شقة، وحدة، مبنى، طابق (اختياري)"
          },
          {
            "type": "text",
            "name": "city",
            "label": "المدينة",
            "required": true
          },
          {
            "type": "text",
            "name": "state",
            "label": "الولاية/المقاطعة/المنطقة",
            "required": true
          },
          {
            "type": "text",
            "name": "postal_code",
            "label": "الرمز البريدي",
            "required": true
          },
          {
            "type": "choice",
            "name": "country",
            "label": "الدولة",
            "required": true,
            "options": [
              "فرنسا",
              "الولايات المتحدة",
              "إيطاليا",
              "المملكة العربية السعودية",
              "الإمارات العربية المتحدة",
              "الجزائر",
              "ألمانيا",
              "كندا",
              "أخرى"
            ]
          }
        ]
      }
    ]
